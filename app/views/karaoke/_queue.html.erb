<%# The room's queue, and the code a phone needs to add to it. Lives inside the
    .karaoke element so the coordinator's outlet resolves; shown on the search
    screen, where someone is actually looking at what comes next. %>
<section class="karaoke-queue" data-controller="karaoke-queue"
         data-karaoke-queue-link-value="<%= @remote_url %>">
  <header class="karaoke-queue__header">
    <h2>Up next <span class="karaoke-queue__count" data-karaoke-queue-target="count"></span></h2>
    <div class="karaoke-queue__tools">
      <%# Both hidden until there is something to act on: a panel that says
          "nothing queued yet" underneath a Clear button reads as broken. %>
      <button type="button" class="karaoke-queue__tool" hidden
              data-karaoke-queue-target="shuffle" data-action="karaoke-queue#shuffle">Shuffle</button>
      <button type="button" class="karaoke-queue__tool" hidden
              data-karaoke-queue-target="clear" data-action="karaoke-queue#clear">Clear</button>
    </div>
  </header>

  <p class="karaoke-queue__empty" data-karaoke-queue-target="empty">
    Nothing queued yet — add songs from the search above, or from a phone.
  </p>

  <ol class="karaoke-queue__list" data-karaoke-queue-target="list"></ol>

  <%# Three ways in, because the room has three kinds of person in it: someone
      who can point a camera (QR), someone who was sent the link (Copy link),
      and someone across the room reading the screen (the URL and code, typed
      by hand). The QR and the link both carry tonight's code; the typed pair
      does not, which is why all three stay. %>
  <div class="karaoke-invite">
    <div class="karaoke-invite__qr">
      <%= qr_code_svg(@remote_url, title: "Scan to add songs from your phone",
                      class: "karaoke-invite__qr-svg") %>
    </div>

    <div class="karaoke-invite__details">
      <p class="karaoke-invite__title">Add songs from your phone</p>
      <p class="karaoke-invite__hint">Scan the code, or go to</p>
      <p class="karaoke-invite__url"><%= @remote_display_url %></p>
      <p class="karaoke-invite__code">Code <strong><%= @remote_code %></strong></p>
      <%= button(text: "Copy link", type: "button", variant: :outline,
                 data: { karaoke_queue_target: "copy", action: "karaoke-queue#copyLink" }) %>
    </div>
  </div>
</section>
