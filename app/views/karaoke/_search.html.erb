<section class="karaoke-screen karaoke-screen--search">
  <h1>Karaoke</h1>
  <%# Searching happens on the phones, not here: the screen is across the room
      from everyone, and a keyboard on it meant one person typing for the lot.
      What it keeps is what you can pick with a remote or a tap — the library
      below — and the code that gets a phone into the queue. %>
  <p>Scan the code to search and add songs from your phone, or pick one of the
     songs below.</p>

  <%= render "karaoke/queue" %>

  <%# Filled from /api/karaoke-history, and hidden until there is anything to
      show. Ready songs come first, and all of them: they are the downloaded
      library — already separated, so they start instantly instead of after a
      Demucs run — and it is the list you browse rather than search. %>
  <div class="karaoke-search__section" data-karaoke-target="readySection" hidden>
    <p class="karaoke-search__section-title">
      Ready to sing <span class="karaoke-search__section-count" data-karaoke-target="readyCount"></span>
    </p>
    <div class="karaoke-results" data-karaoke-target="readyList"></div>
  </div>

  <div class="karaoke-search__section" data-karaoke-target="recentSection" hidden>
    <p class="karaoke-search__section-title">Recently sung</p>
    <div class="karaoke-results" data-karaoke-target="recentList"></div>
  </div>
</section>
