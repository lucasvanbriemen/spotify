# Copy to .env and fill in real values. The Rails app reads these via dotenv.
# Primary database (the music app's MySQL/MariaDB database).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=music
DB_USERNAME=root
DB_PASSWORD=

# Separate database used by the test suite (Rails erases it on every run).
DB_DATABASE_TEST=music_test

# OpenAI writes the English news and presenter scripts.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini

# OpenAI speech is the preferred on-air sound.
TTS_PROVIDER=openai
TTS_VOICE_HOST=marin
TTS_VOICE_COHOST=cedar

# Optional free local fallback. Its persistent localhost service is managed by
# config/supervisor/music-kokoro.conf.
KOKORO_VOICE_HOST=af_heart
KOKORO_VOICE_COHOST=bf_emma
KOKORO_SPEED=1.0

# Station location used for the weather link.
STATION_LAT=52.37
STATION_LON=4.90

# Development only: stands in for a login.ltvb.nl session so a local machine
# doesn't have to round-trip through the production login service. Ignored
# outside Rails.env.development? — see Authentication#local_dev_account.
LOCAL_DEV_ACCOUNT=Lucas
