# Copy to .env and fill in real values. The Rails app reads these via dotenv.
# Primary database (the music app's MySQL/MariaDB database).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=music
DB_USERNAME=root
DB_PASSWORD=

# Separate database used by the test suite (Rails erases it on every run).
DB_DATABASE_TEST=music_test

# Radio presenter generation. Cedar gives the most grounded broadcast-style
# delivery; marin is a good alternative if you prefer a brighter voice.
TTS_PROVIDER=openai
TTS_VOICE_NL=cedar
TTS_VOICE_EN=cedar
