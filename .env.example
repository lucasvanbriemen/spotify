# Copy to .env and fill in real values. The Rails app reads these via dotenv.
# Primary database (the music app's MySQL/MariaDB database).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=music
DB_USERNAME=root
DB_PASSWORD=

# Separate database used by the test suite (Rails erases it on every run).
DB_DATABASE_TEST=music_test

# Radio talk segments (news bulletins, DJ intros, weather checks).
# One OpenAI key covers both the script writing and the text-to-speech.
OPENAI_API_KEY=
# Chat model that writes the bulletins/intros.
OPENAI_TEXT_MODEL=gpt-4o-mini
# TTS provider adapter seam: openai (only one implemented so far).
TTS_PROVIDER=openai
# Voice per language (OpenAI voice names, e.g. alloy/nova/onyx).
TTS_VOICE_NL=alloy
TTS_VOICE_EN=alloy
# open-meteo location for the weather checks (default: Amsterdam).
STATION_LAT=52.37
STATION_LON=4.89
# Default spoken language for stations (per-station overrides live in
# app/models/station.rb).
RADIO_LOCALE=nl
