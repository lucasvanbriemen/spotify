#!/usr/bin/env bash
# Runs the karaoke JavaScript unit tests under plain node (no package.json,
# no test framework to install — node's built-in runner). The --import hook
# resolves the importmap's bare "karaoke/*" specifiers.
set -euo pipefail
cd "$(dirname "$0")/.."

exec node --import ./test/javascript/register.mjs --test test/javascript/*.test.mjs
